<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- .NET 10 Target (سازگار با دات‌نت 10 و ویژوال استودیو جدید) -->
    <!-- در صورتی که دات نت 9 روی سیستم شما نصب است می‌توانید net9.0 قرار دهید -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EducationCertPortal</RootNamespace>
    <AssemblyName>EducationCertPortal</AssemblyName>
    <UserSecretsId>education-cert-portal-secrets-net10</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core برای دیتابیس محلی SQLite یا SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- کتابخانه تولید بارکد و QR کد رسمی بدون وابستگی خارجی -->
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- خواندن و پردازش فایل‌های اکسل پرسنلی -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- اطمینان از کپی فونت‌ها و اسکریپت‌ها در خروجی -->
    <Folder Include="wwwroot\fonts\" />
    <Folder Include="wwwroot\stamps\" />
  </ItemGroup>

</Project>
