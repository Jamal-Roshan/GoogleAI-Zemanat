@inherits LayoutComponentBase
@inject IAuthService AuthService

<div class="min-h-screen flex flex-col md:flex-row bg-slate-50">
    <!-- منوی کناری (Sidebar) -->
    <aside class="w-full md:w-64 bg-white border-l border-slate-200 shrink-0 no-print">
        <NavMenu />
    </aside>

    <!-- محتوای اصلی صفحات -->
    <main class="flex-1 flex flex-col min-w-0">
        <!-- سربرگ بالا -->
        <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between no-print">
            <div class="text-xs text-slate-500 font-bold">
                مدیریت آموزش و پرورش ملایر | امور مالی و حسابداری
            </div>

            <div class="flex items-center gap-3">
                <span class="text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1 rounded-xl font-bold">
                    کاربر: مدیر کل (admin)
                </span>
            </div>
        </header>

        <!-- بدنه محتوا -->
        <div class="p-6 flex-1 overflow-auto">
            @Body
        </div>
    </main>
</div>
